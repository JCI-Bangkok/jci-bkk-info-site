# Database
# For local development, e.g. postgresql://postgres:postgres@localhost:5432/jci_bkk
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/jci_bkk

# Payload CMS Secret
PAYLOAD_SECRET=your-payload-secret-at-least-32-chars-long

# S3 Media Storage (Optional for On-Prem, Required for Vercel)
# S3_BUCKET=jci-bkk-media
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-access-key
# S3_REGION=ap-southeast-1
# S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
